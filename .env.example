# =============================================================================
# mcp-fda — FDA Drug Interaction Checker
# 環境變數範例，複製此檔案為 .env 並填入實際值
# =============================================================================


# -----------------------------------------------------------------------------
# LLM（OpenAI-compatible endpoint）— FDA 資料萃取必要
# 支援：OpenAI、Gemini、LiteLLM proxy、Ollama、vLLM 等任何 OpenAI-compatible 端點
# -----------------------------------------------------------------------------
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=60

# 範例：使用 LiteLLM proxy
# LLM_BASE_URL=http://localhost:4000/v1
# LLM_API_KEY=your-litellm-master-key
# LLM_MODEL=GT-Drug

# 範例：使用 Gemini OpenAI-compatible endpoint
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=your-gemini-api-key
# LLM_MODEL=gemini-2.0-flash


# -----------------------------------------------------------------------------
# GraphRAG Store 後端 — 選擇 SQLite（預設）或 PostgreSQL
# -----------------------------------------------------------------------------
GRAPHRAG_DB_TYPE=sqlite

# SQLite 模式（GRAPHRAG_DB_TYPE=sqlite）
GRAPHRAG_SQLITE_PATH=/app/data/graphrag.db

# PostgreSQL 模式（GRAPHRAG_DB_TYPE=postgresql）
# GRAPHRAG_DB_TYPE=postgresql
# GRAPHRAG_PG_HOST=localhost
# GRAPHRAG_PG_PORT=5432
# GRAPHRAG_PG_NAME=mcp_fda
# GRAPHRAG_PG_USER=your_user
# GRAPHRAG_PG_PASSWORD=your_password


# -----------------------------------------------------------------------------
# FDA API — 可選調整
# -----------------------------------------------------------------------------
FDA_API_BASE=https://api.fda.gov
FDA_CACHE_TTL_DAYS=30
FDA_TIMEOUT=15
FDA_MAX_RETRIES=3


# -----------------------------------------------------------------------------
# MCP / HTTP Server
# -----------------------------------------------------------------------------
TOOL_PREFIX=drug
MCP_SERVER_NAME=mcp-fda
HTTP_HOST=0.0.0.0
HTTP_PORT=8000


# -----------------------------------------------------------------------------
# CORS（選填）
# -----------------------------------------------------------------------------
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
# ENVIRONMENT=development

# -----------------------------------------------------------------------------
# Rate Limiting（選填）
# -----------------------------------------------------------------------------
# RATE_LIMIT_DEFAULT=100/minute
# RATE_LIMIT_QUERY=30/minute
